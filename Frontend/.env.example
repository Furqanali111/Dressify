# Dressify mobile — runtime config
#
# Copy this file to `.env` (same dir) and edit the values for your machine.
# `.env` is gitignored. Anything in here ships in the app bundle, so DO NOT
# put secrets here (API keys, OAuth client secrets, JWT signing keys, etc.) —
# secrets belong on the backend.
#
# Loaded at runtime via `flutter_dotenv` from `lib/core/config/app_flags.dart`.
# `--dart-define=KEY=VALUE` at build time still wins (useful for CI overrides).

# Skip Google sign-in for local UI work. Splash routes straight to profile setup.
# `true` / `false`
BYPASS_AUTH=false

# Backend base URL. Examples:
#   Android emulator → http://10.0.2.2:8000
#   iOS simulator    → http://localhost:8000
#   Physical device  → http://<your-LAN-ip>:8000
#   Production       → https://api.dressify.app
API_BASE_URL=http://localhost:8000

# Optional: Sentry / crash reporting DSN (leave empty to disable)
SENTRY_DSN=
